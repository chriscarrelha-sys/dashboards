  createdAt       DateTime @default(now())
}

model AuthorityVerification {
  id          String   @id @default(cuid())
  authorityId String
  authority   Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  step        String // exists|court-year|quotation|pinpoint|proposition|treatment|controlling
  status      String   @default("pending") // pending|confirmed|failed
  note        String?
  createdAt   DateTime @default(now())
}

model CitationOccurrence {
  id                 String   @id @default(cuid())
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingId           String?
  filing             Filing?  @relation(fields: [filingId], references: [id], onDelete: SetNull)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  citationText       String
  location           String?
  authorityId        String?
  authority          Authority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)
