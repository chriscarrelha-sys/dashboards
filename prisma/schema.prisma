model ResearchQuestion {
  id                 String   @id @default(cuid())
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  question           String
  legalIssueId       String?
  jurisdiction       String?
  priority           String   @default("normal")
  status             String   @default("open") // open|researching|preliminary-answer|verification-needed|complete|superseded|abandoned
  searchTerms        String?
  conclusion         String?
  contraryAuthority  String?
  verificationStatus String   @default("proposed")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @default(now())
}

model ResearchMemorandum {
  id                 String   @id @default(cuid())
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  filingId           String?
