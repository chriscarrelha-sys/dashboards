      "Read(//home/user/dashboards/pro_se_litigation_ops/**)",
      "Write(//home/user/dashboards/pro_se_litigation_ops/cases/**)",
      "Edit(//home/user/dashboards/pro_se_litigation_ops/cases/**)",
      "Glob", "Grep",
