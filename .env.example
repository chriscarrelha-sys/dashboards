# ------------------------------------------------------------------
# Pro Se Wins — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ------------------------------------------------------------------

# Database. Dev uses SQLite (no server needed). Production target: PostgreSQL.
# Postgres example: postgresql://user:pass@localhost:5432/prosewins
DATABASE_URL="file:./dev.db"

# Auth. Local Mac copy: leave AUTH_DEV_MODE="true" (no password, single owner).
# Hosted copy (reachable from your phone): set AUTH_DEV_MODE="false" to require a
# login on every page, then set a long random AUTH_SECRET and an owner password.
AUTH_DEV_MODE="true"
AUTH_SECRET="dev-only-change-me"          # hosted: a long random string (e.g. `openssl rand -hex 32`)

# Owner identity (personalizes your single-user instance).
OWNER_NAME="Case Owner"
OWNER_EMAIL="owner@prosewins.local"

# Hosted login password. Set ONE of these when AUTH_DEV_MODE="false":
#   OWNER_PASSWORD       — simplest: your plaintext password (kept server-side only)
#   OWNER_PASSWORD_HASH  — preferred: a pbkdf2 hash (npm run make:password "yourpw")
OWNER_PASSWORD=""
OWNER_PASSWORD_HASH=""
# Local-only escape hatch for testing hosted mode over http — never set in production.
AUTH_INSECURE_COOKIES=""

# ------------------------------------------------------------------
# AI providers — server-side only. If a key is absent, that provider is
# reported as "unavailable" and the mock provider is used instead.
# NEVER expose these to the client.
# ------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------
# Integrations (all optional; absent = shown as "unavailable" in the hub)
# ------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# File storage. "local" = disk (dev, or a host with a persistent disk). "s3" =
# S3-compatible bucket (Cloudflare R2 / Supabase / Backblaze / AWS) — required for
# a FREE serverless host (e.g. Vercel), whose disk is ephemeral. See docs/HOSTING.md.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage"          # used when STORAGE_PROVIDER="local"

# S3-compatible object storage (used when STORAGE_PROVIDER="s3"):
S3_ENDPOINT=""                          # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"                        # "auto" for R2; e.g. "us-east-1" for AWS
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"              # true for R2/Supabase/MinIO

# ------------------------------------------------------------------
# Phase 6 — production launch (read by `npm run launch:check`).
# All optional in dev; the launch gate reports missing ones honestly.
# ------------------------------------------------------------------
# Private object storage (replaces local disk in production).
STORAGE_PROVIDER=""            # e.g. "s3" | "local" (default local in dev)
# Encryption at rest (managed DB + storage). Required before real case data.
ENCRYPTION_KEY=""
# Off-box backup destination + external job queue (scale-out; jobs run inline if unset).
BACKUP_DESTINATION=""
JOB_QUEUE_URL=""
# Error monitoring (recommended in production).
SENTRY_DSN=""
# Email provider for real email notifications (mock if unset).
EMAIL_PROVIDER=""
# Enforce 2FA + sensitive-op reauth (scaffolding present).
TWO_FACTOR_ENFORCED="false"
# External search backend (local index if unset).
SEARCH_PROVIDER=""

# ------------------------------------------------------------------
# Commercial / billing (Stripe). Billing runs in MOCK mode unless all
# three are set. Never expose these to the browser.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_LIVE=""                # "true" to enable live Stripe (SDK required)
