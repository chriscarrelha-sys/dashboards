# ── AI providers (optional) ─────────────────────────────────────────────
# If unset, the app falls back to the built-in local personalization engine
# so everything runs with zero external dependencies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=

# ── Supabase (Phase 1 integration point — not required for the demo) ────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email delivery (Phase 1 integration point) ─────────────────────────
RESEND_API_KEY=
