# ------------------------------------------------------------------
# Pro Se Wins — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ------------------------------------------------------------------

# Database. Dev uses SQLite (no server needed). Production target: PostgreSQL.
# Postgres example: postgresql://user:pass@localhost:5432/prosewins
DATABASE_URL="file:./dev.db"

# Dev-mode auth. When AUTH_DEV_MODE=true, a fixed local user is signed in with
# no external provider. Set to false once a real auth provider is configured.
AUTH_DEV_MODE="true"
AUTH_SECRET="dev-only-change-me"

# ------------------------------------------------------------------
# AI providers — server-side only. If a key is absent, that provider is
# reported as "unavailable" and the mock provider is used instead.
# NEVER expose these to the client.
# ------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------
# Integrations (all optional; absent = shown as "unavailable" in the hub)
# ------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Local storage root for uploaded originals (dev). Behind StorageProvider interface.
STORAGE_LOCAL_ROOT="./storage"
